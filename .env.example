# Copia este archivo, renómbralo como .env y pega tu contraseña SMTP.
# No compartas el archivo .env.

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=amorales@u4u.mx
SMTP_PASSWORD=PEGA_AQUI_TU_CONTRASENA_SMTP
FROM_NAME=Auri Morales
REPLY_TO=amorales@u4u.mx
SUBJECT=Catálogo U4U para depósitos dentales
DEFAULT_LIMIT=100

# Para reducir problemas de entrega, el envío no va pegado; usa pausa base + pausa aleatoria.
SLEEP_SECONDS=5
SLEEP_JITTER_SECONDS=5

TEST_EMAIL=emmanuelquintan2020@gmail.com

# BCC aleatorio: 10 de cada 100 registros llevarán copia oculta a ambos correos.
BCC_RANDOM_ENABLED=true
BCC_RANDOM_PER_100=10
BCC_RECIPIENTS=bvilenski@gmail.com, arturogoldsmit@gmail.com
